---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: 'What exactly is mentalism?',
    a: 'Mentalism is the art of appearing to read minds, predict decisions, and perceive things that have not been spoken aloud. "Appearing" is doing some work in that sentence, and Solomon has a considered position on how much. He has been performing mentalism for twenty-five years, always in combination with storytelling — which means that by the time something impossible happens, there is usually a story attached to it that makes the impossible feel, in retrospect, almost inevitable.',
  },
  {
    q: 'What kinds of events will Solomon make an appearance',
    a: 'Private parties, such as birthdays, girl’s night, bachelor / bachelorette, company parties and retreats, festivals, theaters, and more. Solomon has performed for groups of five and groups of five hundred. Both, in his experience, contain at least one person who arrived skeptical and left with questions they did not have when they walked in.',
  },
  {
    q: 'How long is a performance?',
    a: 'How ever long you need! In general, parlor or living room shows are 45min. For close-up entertainment for larger parties, weddings, receptions, ect., a good rule of thumb is one hour for every 75 guests.',
  },
  {
    q: 'How far in advance should I book?',
    a: 'Short notice is fine for a standard show, provided Solomon is still available. Holiday times, especially Halloween and Christmas tend to book fast. For special requests such as themes, or special accomodations, a month out is generally sufficient. For corporate events, or locations involving overnight travel, the sooner the better. These tend to involve more moving parts, and he books up accordingly. Don’t hesitate to reach out, Solomon books up fast!',
  },
  {
    q: 'Does Solomon travel?',
    a: 'He is based in Oklahoma City and performs throughout Oklahoma and the surrounding region. For the right engagement, he travels nationally. Travel and accommodation specifics are discussed during the booking conversation.',
  },
  {
    q: 'What does it cost?',
    a: 'Rates vary based on the nature of the event, the duration of the performance, and travel involved. He does not list prices on this website on the reasonable grounds that a private dinner party held locally and a corporate keynote in Dallas are different occasions requiring different conversations. He is happy to provide a clear quote promptly, usually within two business days.',
  },
  {
    q: 'What should I expect from the booking process?',
    a: 'Once you send an inquiry using the form on this site, Solomon will respond typically within two days. He may ask a few questions about the event, the audience, and what your event needs are. As soon as he has the relevant information, and confirms his schedule is available, you’ll receive a price quote. Once everything is agreeable, pay a deposit to confirm the date, and get excited for a fun time. ',
  },
  {
    q: 'Is the performance appropriate for all ages?',
    a: 'Solomon performs for adult audiences. Children can be in attendance (other than his seance show), however he is not a children\'s entertainer and his shows are not designed with younger audiences in mind.',
  },
  {
    q: 'Can guests take photos or video during the performance?',
    a: 'Photography is generally welcome. Videos are not allowed unless permission has been given prior to the show. Solomon is happy to discuss specifics in advance if this matters to you.',
  },
  {
    q: 'Does he need anything from the venue or host?',
    a: 'In most instances, Solomon needs nothing more than 5-10 minutes to set up once he arrives.',
  },
  {
    q: 'What if I need to cancel or reschedule?',
    a: 'Cancellation and rescheduling terms are outlined clearly in the performance agreement before any deposit is made. In general: deposits are non-refundable, and the remainder is not refundable within 30 days of the event, but credits toward a future date are often possible depending on the circumstances. Life happens. He is a reasonable person and conducts himself accordingly.',
  },
];
---

<Layout
  title="FAQ — Solomon Strange"
  description="Answers to the questions first-time clients ask about booking Solomon Strange — what to expect, how it works, and what he prefers you ask before deciding."
>
  <Nav />

  <main id="main-content">

    <!-- Page hero -->
    <section
      style="background:#0f0d0a; padding: 10rem 1.5rem 5rem; text-align:center;"
    >
      <p class="section-label" style="display:block; margin-bottom:1rem;">Before You Ask</p>
      <div class="rule-short"></div>
      <h1
        style="font-family:'Cormorant Garamond',serif; font-size:clamp(2.25rem,5vw,3.5rem); font-weight:400; color:#f5e9cc; letter-spacing:0.04em; margin-top:0.5rem; margin-bottom:1.5rem;"
      >
        Frequently Asked Questions
      </h1>
      <p
        style="font-family:'IM Fell English',serif; font-style:italic; font-size:1.1rem; color:#9a8870; max-width:48ch; margin:0 auto; line-height:1.75;"
      >
        He has answered most of these questions enough times that it seemed
        reasonable to write them down.
      </p>
    </section>

    <!-- FAQ list -->
    <section style="background:#0f0d0a; padding: 0 1.5rem 8rem;">
      <div class="max-w-3xl mx-auto">

        <div class="rule" style="margin-bottom:4rem;"></div>

        <dl class="space-y-0">
          {faqs.map((faq, i) => (
            <div
              class="reveal"
              style={`padding: 2.5rem 0; ${i < faqs.length - 1 ? 'border-bottom: 1px solid rgba(184,146,74,0.12);' : ''}`}
            >
              <!-- Question -->
              <dt
                style="font-family:'Cormorant Garamond',serif; font-size:1.3rem; font-weight:500; color:#f5e9cc; margin-bottom:1rem; line-height:1.4;"
              >
                <span style="color:#b8924a; margin-right:0.75rem; font-size:0.9rem;">✦</span>{faq.q}
              </dt>

              <!-- Answer -->
              <dd
                style="font-family:'Lora',serif; font-size:1rem; color:#a09078; line-height:1.85; margin:0; padding-left:1.75rem;"
              >
                {faq.a}
              </dd>
            </div>
          ))}
        </dl>

        <!-- CTA -->
        <div style="text-align:center; padding-top:4rem;">
          <div class="rule-short"></div>
          <p
            style="font-family:'Cormorant Garamond',serif; font-style:italic; font-size:1.1rem; color:#9a8870; margin-bottom:2rem;"
          >
            Still have a question not covered here?
          </p>
          <a href="/#book" class="btn-gold">Get in Touch</a>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>
