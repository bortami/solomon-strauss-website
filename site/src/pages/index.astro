---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Reel from '../components/Reel.astro';
import About from '../components/About.astro';
import Craft from '../components/Craft.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Shows from '../components/Shows.astro';
import Book from '../components/Book.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Solomon Strange — Mentalist, Magician & Storyteller | Oklahoma"
  description="Award-winning mentalist and magician performing across Oklahoma, from OKC to Tulsa. Interactive mind reading and magic for corporate events and private parties."
>
  <Nav />
  <main id="main-content">
    <Hero />
    <Reel />
    <Craft />
    <Testimonials />
    <Gallery />
    <About />
    <Shows />
    <Book />
  </main>
  <Footer />
</Layout>
