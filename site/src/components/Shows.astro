---
import { upcomingShows } from '../data/shows';

// Don't render the section at all if no shows are scheduled
const hasShows = upcomingShows.length > 0;
---

{hasShows && (
  <section id="shows" style="background:#0f0d0a; padding: 7rem 0;">
    <div class="max-w-4xl mx-auto px-6 md:px-10">

      <!-- Heading -->
      <div class="reveal text-center mb-14">
        <span class="section-label">On Stage</span>
        <div class="rule-short"></div>
        <h2
          style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,2.75rem); font-weight:400; color:#f5e9cc; letter-spacing:0.04em;"
        >
          Upcoming Public Performances
        </h2>
      </div>

      <!-- Shows list -->
      <ul class="space-y-4 list-none p-0 m-0">
        {upcomingShows.map((show, i) => (
          <li
            class={`reveal reveal-delay-${Math.min(i + 1, 3) as 1 | 2 | 3} flex flex-col sm:flex-row sm:items-center justify-between gap-4`}
            style="border-bottom: 1px solid rgba(184,146,74,0.15); padding-bottom: 1.5rem;"
          >
            <!-- Date block -->
            <div class="flex items-start gap-5">
              <div
                class="flex-shrink-0 text-center"
                style="border: 1px solid rgba(184,146,74,0.3); padding: 0.5rem 0.9rem; min-width:58px;"
              >
                <div style="font-family:'Cinzel Decorative',serif; font-size:1.1rem; color:#b8924a; line-height:1;">
                  {show.date.split(' ')[1]?.replace(',','')}
                </div>
                <div style="font-family:'Cormorant Garamond',serif; font-size:0.7rem; letter-spacing:0.2em; text-transform:uppercase; color:#9a8870; margin-top:2px;">
                  {show.date.split(' ')[0]?.slice(0, 3)}
                </div>
              </div>

              <!-- Show details -->
              <div>
                <p style="font-family:'Cormorant Garamond',serif; font-size:1.25rem; font-weight:500; color:#f5e9cc; margin-bottom:0.2rem;">
                  {show.venue}
                </p>
                <p style="font-family:'Lora',serif; font-size:0.85rem; color:#9a8870;">
                  {show.location}
                  {show.day && <> &nbsp;·&nbsp; {show.day}</>}
                  &nbsp;·&nbsp; {show.time}
                </p>
                {show.description && (
                  <p style="font-family:'Lora',serif; font-style:italic; font-size:0.88rem; color:#9a8870; margin-top:0.35rem;">
                    {show.description}
                  </p>
                )}
              </div>
            </div>

            <!-- Ticket CTA -->
            <div class="flex-shrink-0 sm:text-right">
              {show.soldOut ? (
                <span style="font-family:'Cormorant Garamond',serif; font-size:0.78rem; letter-spacing:0.2em; text-transform:uppercase; color:#5a4a38; border:1px solid #3a2a1a; padding:0.45rem 1.1rem;">
                  Sold Out
                </span>
              ) : show.ticketUrl ? (
                <a href={show.ticketUrl} target="_blank" rel="noopener" class="btn-gold" style="padding:0.55rem 1.5rem; font-size:0.78rem;">
                  Tickets
                </a>
              ) : (
                <span style="font-family:'Cormorant Garamond',serif; font-size:0.78rem; letter-spacing:0.2em; text-transform:uppercase; color:#9a8870;">
                  Free Admission
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>

    </div>
  </section>
)}
