---
// Replace these with real testimonials from GigSalad or direct clients
const testimonials = [
  {
    quote: "Absolutely blew us away. He was funny and his timing was excellent. Every trick was compelling and astonishing. Definitely would recommend and will likely hire again!",
    attribution: 'G Rucci. · Private Event · Oklahoma City, OK',
  },
  {
    quote: "This guy was extremely professional, as well as wonderfully entertaining. He goes above and beyond to do a great show and is very, very laid-back and easy to work with. ",
    attribution: 'P. Laughlin. · Corporate Event · Oklahoma City, OK',
  },
  {
    quote: "He was so funny and we were SO impressed with his magic and mentalism. We will be talking about this for weeks and can’t wait to go to one of his shows in the future!",
    attribution: 'K. Scott · Private Event · Ada, OK',
  },
];
---

<section id="testimonials" style="background:#1c1710; padding: 7rem 0;">
  <div class="max-w-5xl mx-auto px-6 md:px-10">

    <!-- Heading -->
    <div class="reveal text-center mb-16">
      <span class="section-label">Reviews</span>
      <div class="rule-short"></div>
      <h2
        style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,2.75rem); font-weight:400; color:#f5e9cc; letter-spacing:0.04em;"
      >
        What people are saying about Solomon Strange
      </h2>
    </div>

    <!-- Rule -->
    <div class="rule mb-14 reveal"></div>

    <!-- Testimonials -->
    <div class="space-y-12">
      {testimonials.map((t, i) => (
        <div class={`reveal reveal-delay-${Math.min(i + 1, 3) as 1 | 2 | 3} testimonial`}>
          <p
            style="font-family:'Cormorant Garamond',serif; font-style:italic; font-size:clamp(1.15rem, 2.5vw, 1.45rem); font-weight:300; color:#e8ddc8; line-height:1.65; margin-bottom:1rem;"
          >
            {t.quote}
          </p>
          <p
            style="font-family:'Cormorant Garamond',serif; font-size:0.8rem; letter-spacing:0.25em; text-transform:uppercase; color:#b8924a;"
          >
            — {t.attribution}
          </p>
        </div>
      ))}
    </div>

    <!-- Rule -->
    <div class="rule mt-14 reveal"></div>

    <!-- GigSalad note -->
    <div class="reveal text-center mt-10">
      <p style="font-family:'Cormorant Garamond',serif; font-size:1rem; color:#9a8870; font-style:italic;">
        You can find more testimonials on
        <a
          href="https://www.gigsalad.com/solomon_Strange_oklahoma_city"
          target="_blank"
          rel="noopener noreferrer"
          style="color:#b8924a; text-decoration:none; border-bottom:1px solid rgba(184,146,74,0.3);"
        >GigSalad</a>. 
      </p>
    </div>

  </div>
</section>
