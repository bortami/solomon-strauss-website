---
// Replace these with real testimonials from GigSalad or direct clients
const testimonials = [
  {
    quote: "I still don't know how he knew. I'm not sure I want to.",
    attribution: 'James R. · Corporate Event · Tulsa, OK',
  },
  {
    quote: "He told a story about three men and a river crossing that had nothing to do with me. And then, somehow, everything to do with me. I'm still thinking about it.",
    attribution: 'Catherine M. · Private Event · Oklahoma City, OK',
  },
  {
    quote: "Our guests talked about him for weeks. He read minds, told stories that seemed impossibly old and perfectly relevant, and knew things about the room that no one had told him. We hired a magician. Solomon Strauss is not a magician.",
    attribution: 'The Hartley Family · Wedding Reception · Edmond, OK',
  },
];
---

<section id="testimonials" style="background:#1c1710; padding: 7rem 0;">
  <div class="max-w-5xl mx-auto px-6 md:px-10">

    <!-- Heading -->
    <div class="reveal text-center mb-16">
      <span class="section-label">What People Say</span>
      <div class="rule-short"></div>
      <h2
        style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,2.75rem); font-weight:400; color:#f5e9cc; letter-spacing:0.04em;"
      >
        Accounts From the Field
      </h2>
    </div>

    <!-- Rule -->
    <div class="rule mb-14 reveal"></div>

    <!-- Testimonials -->
    <div class="space-y-12">
      {testimonials.map((t, i) => (
        <div class={`reveal reveal-delay-${Math.min(i + 1, 3) as 1 | 2 | 3} testimonial`}>
          <p
            style="font-family:'Cormorant Garamond',serif; font-style:italic; font-size:clamp(1.15rem, 2.5vw, 1.45rem); font-weight:300; color:#e8ddc8; line-height:1.65; margin-bottom:1rem;"
          >
            {t.quote}
          </p>
          <p
            style="font-family:'Cormorant Garamond',serif; font-size:0.8rem; letter-spacing:0.25em; text-transform:uppercase; color:#b8924a;"
          >
            — {t.attribution}
          </p>
        </div>
      ))}
    </div>

    <!-- Rule -->
    <div class="rule mt-14 reveal"></div>

    <!-- GigSalad note -->
    <div class="reveal text-center mt-10">
      <p style="font-family:'Cormorant Garamond',serif; font-size:1rem; color:#9a8870; font-style:italic;">
        He has, over the years, accumulated a considerable number of reviews on
        <a
          href="https://www.gigsalad.com/solomon_strauss_oklahoma_city"
          target="_blank"
          rel="noopener noreferrer"
          style="color:#b8924a; text-decoration:none; border-bottom:1px solid rgba(184,146,74,0.3);"
        >GigSalad</a>. Make of that what you will.
      </p>
    </div>

  </div>
</section>
