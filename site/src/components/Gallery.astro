---
---

<section id="gallery" style="background:#0f0d0a; padding: 7rem 0;">
  <div class="max-w-6xl mx-auto px-6 md:px-10">

    <div class="reveal text-center mb-14">
      <span class="section-label">In Performance</span>
      <div class="rule-short"></div>
      <h2
        style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,2.75rem); font-weight:400; color:#f5e9cc; letter-spacing:0.04em;"
      >
        The Work
      </h2>
    </div>

    <!-- Masonry grid — 2 cols mobile, 3 cols desktop -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 reveal">

      <!-- Row 1: portrait + wide landscape spanning 2 cols -->


            <div class="relative overflow-hidden aspect-square gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
        <img
          src="/images/gallery/IMG_3035.jpg"
          alt="Solomon Strange at an event"
          class="absolute inset-0 w-full h-full object-cover"
          style="filter:contrast(1.05) sepia(0.12);"
          loading="lazy"
        />
        <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
      </div>
      <div class="relative overflow-hidden aspect-square gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
        <img
          src="/images/gallery/8A5A8375.jpg"
          alt="Solomon Strange performing mentalism"
          class="absolute inset-0 w-full h-full object-cover"
          style="filter:contrast(1.05) sepia(0.12);"
          loading="lazy"
        />
        <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
      </div>
      <div class="relative overflow-hidden aspect-square gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
        <img
          src="/images/gallery/IMG_8626%20conv.jpeg"
          alt="Solomon Strange close-up"
          class="absolute inset-0 w-full h-full object-cover"
          style="filter:contrast(1.05) sepia(0.12);"
          loading="lazy"
        />
        <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
      </div>


      <!-- Row 2: three equal columns -->

      <div class="relative overflow-hidden aspect-[3/4] md:aspect-[4/3] col-span-1 md:col-span-2 gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
        <img
          src="/images/gallery/8A5A8340.jpg"
          alt="Solomon Strange performing"
          class="absolute inset-0 w-full h-full object-cover"
          style="filter:contrast(1.05) sepia(0.12);"
          loading="lazy"
        />
        <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
      </div>

 <div class="relative overflow-hidden aspect-2/3 gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
        <img
          src="/images/gallery/IMG_4557.jpeg"
          alt="Solomon Strange close-up"
          class="absolute inset-0 w-full h-full object-cover"
          style="filter:contrast(1.05) sepia(0.12);"
          loading="lazy"
        />
        <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
      </div>

      <!-- Row 3: full-width cinematic shot -->
      <div class="relative overflow-hidden aspect-[16/9] col-span-2 md:col-span-3 gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
        <img
          src="/images/gallery/8A5A8425.jpg"
          alt="Solomon Strange on stage"
          class="absolute inset-0 w-full h-full object-cover"
          style="filter:contrast(1.05) sepia(0.12);"
          loading="lazy"
        />
        <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
      </div>

    </div>

    <!-- Video reel -->
    <div class="reveal mt-3">
      <div
        class="relative w-full aspect-video gold-corners"
        style="background:#1c1710; border: 1px solid rgba(184,146,74,0.2);"
      >
        <iframe
          src="https://www.youtube.com/embed/hN3cbVCqz04"
          class="absolute inset-0 w-full h-full"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          title="Solomon Strange performance reel"
        ></iframe>
      </div>
    </div>

  </div>
</section>
