---
---

<section id="gallery" aria-labelledby="gallery-heading" style="background:#0f0d0a; padding: 7rem 0;">
  <div class="max-w-6xl mx-auto px-6 md:px-10">

    <div class="reveal text-center mb-14">
      <h2
        id="gallery-heading"
        style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,2.75rem); font-weight:400; color:#f5e9cc; letter-spacing:0.04em;"
      >
        On Stage &amp; Up Close
      </h2>
      <div class="rule-short"></div>
    </div>

    <!-- Masonry grid — 2 cols mobile, 3 cols desktop -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 reveal">

      <!-- Row 0: hero shot, full width -->
      <figure class="relative overflow-hidden aspect-[16/9] col-span-2 md:col-span-3 gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
        <img
          src="/images/gallery/solomon-strange-hero.jpg"
          alt="Solomon Strange performing on stage with his cast"
          class="absolute inset-0 w-full h-full object-cover"
          style="filter:contrast(1.05) sepia(0.12);"
          loading="lazy"
        />
        <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
      </figure>

      <!-- Row 1: four squares — 2×2 on mobile, one row on desktop -->
      <div class="col-span-2 md:col-span-3 grid grid-cols-2 md:grid-cols-4 gap-3">
        <figure class="relative overflow-hidden aspect-square gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
          <img
            src="/images/gallery/solomon-strange-event.jpg"
            alt="Solomon Strange at an event"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter:contrast(1.05) sepia(0.12);"
            loading="lazy"
          />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
        </figure>
        <figure class="relative overflow-hidden aspect-square gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
          <img
            src="/images/gallery/solomon-strange-mentalism.jpg"
            alt="Solomon Strange performing mentalism"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter:contrast(1.05) sepia(0.12);"
            loading="lazy"
          />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
        </figure>
        <figure class="relative overflow-hidden aspect-square gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
          <img
            src="/images/gallery/solomon-strange-closeup-1.jpeg"
            alt="Solomon Strange close-up"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter:contrast(1.05) sepia(0.12);"
            loading="lazy"
          />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
        </figure>
        <figure class="relative overflow-hidden aspect-square gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
          <img
            src="/images/gallery/solomon-strange-living-room-web.jpg"
            alt="Solomon Strange performing mentalism for guests at a private party in a living room"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter:contrast(1.05) sepia(0.12);"
            loading="lazy"
          />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
        </figure>
      </div>

      <!-- Row 2: wide + portrait, always paired on one row -->

      <div class="col-span-2 md:col-span-3 grid grid-cols-2 md:grid-cols-3 gap-3">
        <figure class="relative overflow-hidden aspect-[3/4] md:aspect-[4/3] col-span-1 md:col-span-2 gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
          <img
            src="/images/gallery/solomon-strange-performance.jpg"
            alt="Solomon Strange performing"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter:contrast(1.05) sepia(0.12);"
            loading="lazy"
          />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
        </figure>

        <figure class="relative overflow-hidden aspect-[3/4] md:aspect-2/3 gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
          <img
            src="/images/gallery/solomon-strange-private-party-web.jpg"
            alt="Solomon Strange performing a private Halloween party show in a decorated living room"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter:contrast(1.05) sepia(0.12);"
            loading="lazy"
          />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
        </figure>
      </div>

      <!-- Row 3: last two shots share a row -->
      <div class="col-span-2 md:col-span-3 grid grid-cols-2 gap-3">
        <figure class="relative overflow-hidden aspect-[3/2] gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
          <img
            src="/images/gallery/solomon-strange-onstage.jpg"
            alt="Solomon Strange on stage"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter:contrast(1.05) sepia(0.12);"
            loading="lazy"
          />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
        </figure>
        <figure class="relative overflow-hidden aspect-[3/2] gold-corners" style="border:1px solid rgba(184,146,74,0.1);">
          <img
            src="/images/gallery/solomon-strange-portrait.jpg"
            alt="Solomon Strange performing"
            class="absolute inset-0 w-full h-full object-cover"
            style="filter:contrast(1.05) sepia(0.12);"
            loading="lazy"
          />
          <div class="absolute inset-0 opacity-0 transition-opacity duration-300 hover:opacity-100" style="background:rgba(184,146,74,0.06);"></div>
        </figure>
      </div>

    </div>

  </div>
</section>
