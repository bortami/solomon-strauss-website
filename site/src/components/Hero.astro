---
---

<section
  id="top"
  class="relative min-h-screen flex flex-col items-center justify-center text-center hero-bg texture overflow-hidden"
  style="padding: 6rem 1.5rem 4rem;"
>
  <!-- Optional: swap this div for a real <img> once you have photography -->
  <!-- <img src="/images/hero.jpg" alt="Solomon Strauss" class="absolute inset-0 w-full h-full object-cover object-center opacity-25" /> -->

  <!-- Vignette overlay -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 70% 70% at 50% 50%, transparent 30%, rgba(15,13,10,0.85) 100%); z-index: 2;"
  ></div>

  <!-- Content -->
  <div class="relative max-w-3xl mx-auto" style="z-index: 3;">

    <!-- Ornament -->
    <p class="ornament mb-6" style="font-size:0.85rem; letter-spacing:0.6em;" aria-hidden="true">· · · ✦ · · ·</p>

    <!-- Name -->
    <h1
      style="font-family: 'Cinzel Decorative', serif; font-size: clamp(1.75rem, 5vw, 3.25rem); color: #f5e9cc; font-weight: 400; letter-spacing: 0.06em; line-height: 1.2; margin-bottom: 1.5rem;"
    >
      Solomon Strauss
    </h1>

    <!-- Rule -->
    <div class="rule max-w-xs mx-auto mb-5"></div>

    <!-- Subtitle -->
    <p
      style="font-family: 'Cormorant Garamond', serif; font-size: clamp(1.1rem, 2.5vw, 1.5rem); font-style: italic; font-weight: 300; color: #b8924a; letter-spacing: 0.15em; margin-bottom: 0.85rem;"
    >
      Mentalist &nbsp;·&nbsp; Storyteller
    </p>

    <!-- Location -->
    <p
      style="font-family: 'Cormorant Garamond', serif; font-size: 0.8rem; letter-spacing: 0.3em; text-transform: uppercase; color: #9a8870; margin-bottom: 2.25rem;"
    >
      Oklahoma City &nbsp;·&nbsp; Oklahoma &nbsp;·&nbsp; Beyond
    </p>

    <!-- Tagline -->
    <p
      style="font-family: 'Lora', serif; font-size: clamp(1rem, 2vw, 1.15rem); color: #9a8870; max-width: 46ch; margin: 0 auto 3rem; line-height: 1.8;"
    >
      Twenty-five years of old stories, close secrets, and the art
      of knowing what you were thinking before you did.
  
    </p>

    <!-- CTA -->
    <a href="#book" class="btn-gold">Book an Experience</a>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2"
    style="z-index: 3; opacity: 0.4;"
    aria-hidden="true"
  >
    <span style="font-family:'Cormorant Garamond',serif; font-size:0.7rem; letter-spacing:0.3em; text-transform:uppercase; color:#b8924a;">Scroll</span>
    <div style="width:1px; height:40px; background: linear-gradient(180deg,#b8924a,transparent);"></div>
  </div>
</section>
