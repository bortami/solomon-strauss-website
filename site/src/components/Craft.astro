---
const services = [
  {
    glyph: '⬡',
    title: 'Private Engagements',
    body: 'For parties or 5 or more, in your enjoy a private show that will leave you and your guests something to remember for a long time, all from the comfort of your own couch.',
    detail: '',
  },  {
    glyph: '❖',
    title: 'Stage & Parlor',
    body: 'An evening-length experience of stand up entertainment for rooms full of people who came for a show and leave with a story. Experience having your mind read, controlled, and influenced, and magical feats. Don’t worry though, Solomon only tells the good things he sees! ',
    detail: '',
  }, 
    {
    glyph: '◈',
    title: 'Seance /Spiritualism Show',
    body: 'A one of a kind evening for small groups who are brave enough to experience something otherworldly. This is not for the faint of heart, and only for adults 18+. This show contains ghost stories, strange magic, and adult themes not suitable for the faint of heart or anyone under 18yrs old. Solomon will attempt to speak to the spirits, and they might just try to answer him...... ',
    detail: '',
  },
];
---

<section id="craft" style="background:#1c1710; padding: 7rem 0;">
  <div class="max-w-6xl mx-auto px-6 md:px-10">

    <!-- Heading -->
    <div class="reveal text-center mb-16">
      <span class="section-label">What I Do</span>
      <div class="rule-short"></div>
      <h2
        style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,2.75rem); font-weight:400; color:#f5e9cc; letter-spacing:0.04em;"
      >
        Services
      </h2>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-3 gap-6">
      {services.map((s, i) => (
        <div class={`craft-card reveal reveal-delay-${i + 1 as 1 | 2 | 3}`}>
          <!-- Glyph -->
          <div style="font-size:1.5rem; color:rgba(184,146,74,0.5); margin-bottom:1.25rem;" aria-hidden="true">
            {s.glyph}
          </div>

          <!-- Title -->
          <h3
            style="font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:400; color:#f5e9cc; margin-bottom:1rem; letter-spacing:0.03em;"
          >
            {s.title}
          </h3>

          <!-- Rule -->
          <div style="width:36px; height:1px; background:#b8924a; opacity:0.6; margin-bottom:1.25rem;"></div>

          <!-- Body -->
          <p style="color:#a09078; font-size:0.97rem; line-height:1.8; margin-bottom:1.5rem;">
            {s.body}
          </p>

          <!-- Detail -->
          <p
            style="font-family:'Cormorant Garamond',serif; font-size:0.8rem; letter-spacing:0.2em; text-transform:uppercase; color:#9a8870;"
          >
            {s.detail}
          </p>
        </div>
      ))}
    </div>

    <!-- Epigraph -->
    <div class="reveal text-center mt-20" style="max-width:52ch; margin-left:auto; margin-right:auto;">
      <p style="font-family:'IM Fell English',serif; font-style:italic; font-size:1.15rem; color:#9a8870; line-height:1.7;">
        "If your aim in life is pursuing truth, one of the things you might want to study is why deception is so common in life."
        <span style="display:block; font-size:0.8rem; letter-spacing:0.2em; margin-top:0.75rem; opacity:0.5;">~ Eugene Burger</span>
      </p>
    </div>
  </div>
</section>
