---
const year = new Date().getFullYear();

const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/solomon.strauss/' },
  { label: 'GigSalad',  href: 'https://www.gigsalad.com/solomon_strange' }
];
---

<footer style="background:#0a0908; border-top: 1px solid rgba(184,146,74,0.12); padding: 3rem 0 2rem;">
  <div class="max-w-6xl mx-auto px-6 md:px-10">

    <div class="flex flex-col md:flex-row items-center justify-between gap-6">

      <!-- Logo / name -->
      <div class="text-center md:text-left">
        <p style="font-family:'Cinzel Decorative',serif; font-size:0.8rem; letter-spacing:0.1em; color:#f5e9cc; margin-bottom:0.35rem;">
          Solomon Strange
        </p>
        <!-- Solid color: #9a8870 passes at 5.66:1 on #0a0908 -->
        <p style="font-family:'Cormorant Garamond',serif; font-size:0.78rem; letter-spacing:0.15em; text-transform:uppercase; color:#9a8870;">
          Mentalist &nbsp;·&nbsp; Storyteller &nbsp;·&nbsp; Oklahoma City
        </p>
      </div>

      <!-- Social links -->
      <nav aria-label="Social media links" class="flex items-center gap-6">
        {socialLinks.map(s => (
          <a
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="footer-social-link"
          >
            {s.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Divider -->
    <div class="rule my-6" style="opacity:0.2;" role="separator"></div>

    <!-- Footer nav -->
    <div style="text-align:center; margin-bottom:1rem;">
      <a
        href="/faq"
        class="footer-faq-link"
      >Frequently Asked Questions</a>
    </div>

    <!-- Copyright — #9a8870 passes at 5.81:1 on #0a0908 -->
    <p style="text-align:center; font-family:'Cormorant Garamond',serif; font-size:0.78rem; letter-spacing:0.15em; color:#9a8870;">
      &copy; {year} Solomon Strange &nbsp;·&nbsp; He knows.
    </p>

  </div>
</footer>

<style>
  .footer-social-link {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    /* #9a8870 passes at 5.66:1 on #0a0908 */
    color: #9a8870;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer-social-link:hover,
  .footer-social-link:focus-visible {
    color: #b8924a;
  }

  .footer-faq-link {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9a8870;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer-faq-link:hover,
  .footer-faq-link:focus-visible {
    color: #b8924a;
  }
</style>
