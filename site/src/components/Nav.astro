---
import { upcomingShows } from '../data/shows';

const isHome = Astro.url.pathname === '/';
const p = (anchor: string) => isHome ? anchor : `/${anchor}`;

const links = [
  { href: p('#about'),        label: 'About' },
  { href: p('#craft'),        label: 'The Craft' },
  { href: p('#testimonials'), label: 'Testimonials' },
  ...(upcomingShows.length > 0 ? [{ href: p('#shows'), label: 'Shows' }] : []),
  { href: p('#book'),         label: 'Book' },
];

const logoHref = isHome ? '#top' : '/';
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  style="background: rgba(15,13,10,0); backdrop-filter: blur(0px);"
>
  <div class="max-w-6xl mx-auto px-6 md:px-10 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a
      href={logoHref}
      class="text-cream no-underline"
      style="font-family: 'Cinzel Decorative', serif; font-size: 0.85rem; letter-spacing: 0.1em; color: #f5e9cc;"
    >
      Solomon Strauss
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary navigation" class="hidden md:flex items-center gap-8">
      {links.map(l => (
        <a href={l.href} class="nav-link">{l.label}</a>
      ))}
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 cursor-pointer border-none bg-transparent"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-6 h-px" style="background:#b8924a;"></span>
      <span class="block w-6 h-px" style="background:#b8924a;"></span>
      <span class="block w-4 h-px" style="background:#b8924a;"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden flex-col items-center gap-6 py-8"
    style="background: rgba(15,13,10,0.98); border-top: 1px solid rgba(184,146,74,0.2);"
  >
    {links.map(l => (
      <a href={l.href} class="nav-link text-lg">{l.label}</a>
    ))}
  </div>
</header>

<script>
  // Darken nav on scroll
  const nav = document.getElementById('site-nav');
  window.addEventListener('scroll', () => {
    if (!nav) return;
    const scrolled = window.scrollY > 60;
    nav.style.background = scrolled
      ? 'rgba(15,13,10,0.95)'
      : 'rgba(15,13,10,0)';
    nav.style.backdropFilter = scrolled ? 'blur(8px)' : 'blur(0px)';
    nav.style.borderBottom = scrolled ? '1px solid rgba(184,146,74,0.12)' : 'none';
  });
</script>
