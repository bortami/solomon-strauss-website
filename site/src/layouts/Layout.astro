---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Solomon Strauss — Mentalist & Storyteller | Oklahoma City',
  description = 'Solomon Strauss is an award-winning mentalist and storyteller based in Oklahoma City. Twenty-five years of close-up magic, stage illusions, and the kind of knowing that keeps people up at night.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://solomonstrauss.com');
const ogImage = 'https://solomonstrauss.com/images/solomon-headshot.jpg';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0d0a" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Solomon Strauss" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Solomon Strauss",
      "jobTitle": "Mentalist & Storyteller",
      "url": "https://solomonstrauss.com",
      "image": "https://solomonstrauss.com/images/solomon-headshot.jpg",
      "description": "Award-winning mentalist and storyteller based in Oklahoma City with 25 years of experience performing close-up magic, mentalism, and stage shows.",
      "areaServed": [
        { "@type": "City", "name": "Oklahoma City" },
        { "@type": "Country", "name": "United States" }
      ],
      "sameAs": [
        "https://www.instagram.com/solomon.strauss/",
        "https://www.gigsalad.com/solomon_strauss_oklahoma_city"
      ]
    }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Lora:ital,wght@0,400;0,500;1,400&family=IM+Fell+English:ital@1&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Skip to main content (WCAG 2.4.1) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot />

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Mobile nav toggle with aria-expanded
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const isOpen = mobileMenu?.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
      // Close mobile menu on link click
      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileMenu.classList.remove('open'));
      });
    </script>
  </body>
</html>
